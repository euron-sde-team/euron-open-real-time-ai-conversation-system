# Generated by `make env` (scripts/gen-local-env.sh) with random values. Local only.
CONV_JWT_SECRET=replace-with-output-of-make-env
CONV_REFRESH_SECRET=replace-with-output-of-make-env
# 32 random bytes, base64 (openssl rand -base64 32): encrypts stored TOTP secrets.
CONV_TOTP_ENCRYPTION_KEY=replace-with-output-of-make-env
# Every demo account (make demo) signs in with this password.
CONV_DEMO_PASSWORD=replace-with-output-of-make-env

# Real model providers (optional: `make demo` registers the "Stub" provider, which
# needs no key). Realtime voice interviews need OPENAI_API_KEY (OpenAI Realtime) or
# GEMINI_API_KEY (Gemini Live); plans and scoring use any text provider. Either one
# JSON object keyed by provider slug ...
# PROVIDER_KEYS={"openai":"sk-...","gemini":"...","anthropic":"sk-ant-..."}
# ... or the single-key shortcuts (PROVIDER_KEYS wins when both name a provider):
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# GROQ_API_KEY=gsk_...

# Where realtime credentials are minted (defaults: the real OpenAI and Gemini APIs).
# The stubs' fake endpoints, as the tests use:
# OPENAI_REALTIME_URL=http://stubs:5139/v1
# GEMINI_LIVE_URL=http://stubs:5139/gemini/v1alpha
# Origins the browser may open realtime voice connections to (the web CSP's
# connect-src; space separated). Default: Gemini Live's WebSocket host.
# REALTIME_ORIGINS=wss://generativelanguage.googleapis.com
# Largest resume accepted, in MB (read in memory, never stored).
# MAX_RESUME_MB=8

# Optional overrides (host ports and names)
# CONV_PRODUCT_NAME=Euron Open Conversation
# CONV_LOG_LEVEL=info
# CONV_WEB_PORT=3550
# CONV_API_PORT=5046
# CONV_PG_PORT=5512
# CONV_REDIS_PORT=6449
# CONV_MAILPIT_PORT=8066
# CONV_SMTP_PORT=1066
# CONV_FLOCI_PORT=4617
# CONV_STUB_PORT=5139
